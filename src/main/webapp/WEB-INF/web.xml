<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>
  <context-param>
    <param-name>applicationLabel</param-name>
    <param-value>Botien | Hospital Management System</param-value>
  </context-param>

  <servlet>
    <servlet-name>Index</servlet-name>
    <servlet-class>hospital.sys.Index</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>Home</servlet-name>
    <servlet-class>hospital.sys.Home</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>Login</servlet-name>
    <servlet-class>hospital.sys.Login</servlet-class>
    <init-param>
      <param-name>username</param-name>
      <param-value>johannes@graz.com</param-value>
    </init-param>
    <init-param>
      <param-name>password</param-name>
      <param-value>Cohort123*</param-value>
    </init-param>
  </servlet>
  <servlet>
    <servlet-name>Register</servlet-name>
    <servlet-class>hospital.sys.Register</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>Index</servlet-name>
    <url-pattern></url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>Home</servlet-name>
    <url-pattern>/home</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>Login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>Register</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

</web-app>
